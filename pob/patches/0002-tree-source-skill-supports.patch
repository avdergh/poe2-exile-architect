+local function getTreeGrantedSkillLevel(skillId, characterLevel, fallbackLevel)
+	local grantedEffect = data.skills[skillId]
+	if not grantedEffect or not grantedEffect.levels then
+		return fallbackLevel
+	end
+	local gemId = data.gemForSkill[grantedEffect]
+	local gemData = gemId and data.gems[gemId]
+	local naturalMaxLevel = gemData and tonumber(gemData.naturalMaxLevel) or #grantedEffect.levels
+	local selectedLevel = 1
+	for level = 1, naturalMaxLevel do
+		local levelData = grantedEffect.levels[level]
+		if levelData and (tonumber(levelData.levelRequirement) or 0) <= (tonumber(characterLevel) or 1) then
+			selectedLevel = level
+		end
+	end
+	return selectedLevel
+end
